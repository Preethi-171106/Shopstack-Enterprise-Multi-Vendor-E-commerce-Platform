# ============================================================
# ShopStack — Environment Variables Template
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values
# 3. NEVER commit .env to version control
# ============================================================

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT — generate: openssl rand -hex 32 | base64
JWT_SECRET=your_jwt_secret_base64_encoded_here
JWT_EXPIRATION=86400000

# Razorpay (get keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Spring profiles (use 'local' for dev with verbose logging)
SPRING_PROFILES_ACTIVE=default

# JPA DDL — 'update' for dev, 'validate' for production
JPA_DDL_AUTO=update

# CORS — set to actual frontend URL in production
# Multiple origins: comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Password Reset
PASSWORD_RESET_EXPIRY_MINUTES=30
FRONTEND_URL=http://localhost:5173
# Set to true in local dev to print reset links to logs when email is not configured
APP_DEV_MODE=false

# Email (optional — required for password reset emails)
# Example using Gmail with App Password:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-email@gmail.com
#   MAIL_PASSWORD=your-app-password
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@shopstack.com
